# Supabase — from your project's API settings (Project Settings → API).
# Safe to expose to the browser (the anon key is protected by Row-Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Where the app is reachable (used to build the OAuth redirect URL).
# Local dev: http://localhost:3000 — set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev tooling only (NOT used by the app at runtime): `pnpm gen:types` regenerates
# src/lib/supabase/database.types.ts from the database. Create a token at
# Supabase → Account → Access Tokens. The project ref is read from NEXT_PUBLIC_SUPABASE_URL above.
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# E2E tests only (NOT used by the app): the SERVICE ROLE key lets the test setup create a confirmed
# throwaway user and DELETE it afterwards (which cascades away all its data). Powerful — keep secret,
# never expose to the browser, never commit. Supabase → Project Settings → API → service_role.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# `pnpm db:backup` only: direct Postgres connection string for data snapshots.
# Supabase → Project Settings → Database → Connection string (URI).
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres